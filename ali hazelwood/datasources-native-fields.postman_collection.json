            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolve_choices\": [\n    {\n      \"type\": \"native_dropdown\",\n      \"datasource_id\": \"0\",\n      \"field_id\": \"{{status_field_id}}\",\n      \"choice_ids\": [2, 3, 99999]\n    },\n    {\n      \"type\": \"native_dropdown\",\n      \"datasource_id\": \"0\",\n      \"field_id\": \"{{category_field_id}}\",\n      \"dependent_choice_values\": [\n        [\"Hardware\", \"Peripherals\", \"Router\"],\n        [\"Hardware\", \"nonexistent\", \"bad-path\"]\n      ]\n    },\n    {\n      \"type\": \"native_dropdown\",\n      \"datasource_id\": \"5\",\n      \"sub_item_id\": \"{{sub_item_id}}\",\n      \"field_id\": \"{{service_field_id}}\",\n      \"choice_ids\": [\"ab4b1d96-7631-4de1-bffc-d6228f249156\", \"bad-id\"]\n    },\n    {\n      \"type\": \"native_lookups\",\n      \"datasource_id\": \"0\",\n      \"choice_ids\": [153, 999999]\n    },\n    {\n      \"type\": \"native_lookups\",\n      \"datasource_id\": \"1\",\n      \"choice_values\": [\"Andrea\", \"nobody-here\"]\n    },\n    {\n      \"type\": \"native_dropdown\",\n      \"datasource_id\": \"0\",\n      \"field_id\": \"{{status_field_id}}\",\n      \"choice_ids\": [2],\n      \"choice_values\": [\"Open\"]\n    }\n  ]\n}",
